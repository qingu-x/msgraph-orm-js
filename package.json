{
  "name": "@qingu-x/msgraph-orm-js",
  "version": "0.1.0",
  "type": "module",
  "description": "Microsoft Graph JavaScript SDK for Qingu-X",
  "main": "lib/bundle.cjs.js",
  "module": "lib/bundle.esm.js",
  "browser": "lib/bundle.browser.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./lib/bundle.browser.js",
      "import": "./lib/bundle.esm.js",
      "require": "./lib/bundle.cjs.js",
      "default": "./lib/bundle.esm.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingu-x/msgraph-orm-js.git"
  },
  "files": [
    "src",
    "types",
    "lib"
  ],
  "scripts": {
    "test": "jest",
    "commit": "cz",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch"
  },
  "keywords": [
    "template",
    "sdk",
    "npmjs",
    "npm",
    "qingu",
    "qingu-x",
    "msgraph",
    "meeting"
  ],
  "author": "QingU Inc.",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/qingu-x/msgraph-orm-js/issues"
  },
  "homepage": "https://github.com/qingu-x/msgraph-orm-js#readme",
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@microsoft/microsoft-graph-client": "^3.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/css": "^0.9.0",
    "@eslint/js": "^9.29.0",
    "@eslint/json": "^0.12.0",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "commitlint": "^19.8.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.29.0",
    "https-proxy-agent": "^7.0.6",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "terser": "^5.44.0",
    "ts-jest": "^29.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
